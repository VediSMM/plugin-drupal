"Language: ru\n"

msgid "Send content to VediSMM"
msgstr "Отправлять контент в VediSMM"

msgid "Send to VediSMM"
msgstr "Отправить в VediSMM"

msgid "Content sent to VediSMM."
msgstr "Материал отправлен в VediSMM."

msgid "The selected content could not be loaded."
msgstr "Не удалось загрузить выбранный материал."

msgid "The selected content type is not supported."
msgstr "Выбранный тип материала не поддерживается."

msgid "You are not allowed to send the selected content."
msgstr "У вас нет права отправлять выбранный материал."

msgid "VediSMM API token"
msgstr "API-токен VediSMM"

msgid "VediSMM API base URL"
msgstr "Базовый URL API VediSMM"

msgid "Use an absolute HTTP or HTTPS URL. The default is the public VediSMM API."
msgstr "Укажите абсолютный HTTP- или HTTPS-URL. По умолчанию используется публичный API VediSMM."

msgid "A token is saved. Leave this field blank to keep it unchanged."
msgstr "Токен сохранён. Оставьте поле пустым, чтобы не изменять его."

msgid "Enter the server-side token used to authenticate VediSMM API requests."
msgstr "Введите серверный токен для аутентификации запросов к API VediSMM."

msgid "Remove the saved API token"
msgstr "Удалить сохранённый API-токен"

msgid "Requests fail closed until a new token is saved."
msgstr "До сохранения нового токена запросы безопасно отклоняются."

msgid "Save configuration"
msgstr "Сохранить конфигурацию"

msgid "Enter an absolute HTTP or HTTPS API base URL."
msgstr "Введите абсолютный HTTP- или HTTPS-URL API."

msgid "The VediSMM configuration has been saved."
msgstr "Конфигурация VediSMM сохранена."

msgid "Tracking links"
msgstr "Трекинговые ссылки"

msgid "Shorten links"
msgstr "Сокращать ссылки"

msgid "Create a separate short link automatically for each target network."
msgstr "Автоматически создавать отдельную короткую ссылку для каждой целевой площадки."

msgid "Add network source"
msgstr "Добавлять источник площадки"

msgid "Available only with shortening. If utm_source is absent, add utm_source=<network> and preserve existing utm_term. If utm_source exists, preserve it and replace or add one utm_term=<network>."
msgstr "Доступно только вместе с сокращением. Если utm_source отсутствует, добавить utm_source=<network> и сохранить существующий utm_term. Если utm_source уже есть, сохранить его и заменить либо добавить один utm_term=<network>."
